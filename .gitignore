# Dependencies
node_modules/

# Environment
.env
.env.local
.env.*.local
*.env

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary
*.tmp
.temp/
tmp/

# SpecWeave
.specweave/cache/
.specweave/increments/*/logs/
.specweave/increments/*/test-results/
.specweave/docs-site-internal/
.claude-plugin/
plugins/
vskill.lock
# Work handoff (secret-scrubbed, never auto-committed)
.handoff/
.specweave/state/handoff-latest.*
# Runtime state (machine-local, regenerated)
.specweave/state/
.specweave/logs/
.specweave/backups/
.specweave/jobs/
# Binary evidence and agent worktrees (never committed)
.specweave/increments/**/reports/artifacts/
.claude/worktrees/
.worktrees/
# Binary evidence in reports/ (videos, screenshots)
**/reports/*.mp4
**/reports/*.png
**/reports/*.jpg
